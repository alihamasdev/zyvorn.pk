{
	"name": "zyvorn",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"zod": "^4.6.7",
			"@types/node": "^26.6.5",
			"@types/bun": "^1.4.4",
			"varlock": "1.23.0",
			"next-themes": "^0.4.6",
			"sonner": "^2.0.8",
			"tailwindcss": "^4.3.3",
			"convex": "^1.48.0 ",
			"better-auth": "1.6.17",
			"@convex-dev/better-auth": "^0.12.5",
			"@tanstack/react-form": "^1.33.5",
			"@better-auth/expo": "1.6.17"
		}
	},
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"check": "oxlint --fix && oxfmt --write",
		"check-types": "turbo run check-types",
		"deploy": "bunx vercel deploy",
		"deploy:check": "bunx vercel deploy --dry",
		"deploy:prod": "bunx vercel deploy --prod",
		"deploy:setup": "bunx vercel link",
		"dev": "turbo run dev",
		"dev:native": "turbo run dev -F native --",
		"dev:server": "turbo run dev -F @zyvorn/backend --",
		"dev:vercel": "bunx vercel dev -L",
		"dev:web": "turbo run dev -F web --",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/native/",
		"env:preview": "tsx scripts/sync-vercel-env.ts preview",
		"env:production": "tsx scripts/sync-vercel-env.ts production",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/native/"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@shadcn/lint": "^0.2.3",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"@zyvorn/config": "workspace:*",
		"lefthook": "^2.2.1",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"tsx": "^4.23.13",
		"turbo": "^2.11.7",
		"typescript": "^6.0.3",
		"varlock": "catalog:"
	},
	"packageManager": "bun@1.4.2"
}
