{
	"name": "zyvorn",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"zod": "^4.6.7",
			"@types/node": "^26.6.10",
			"@tanstack/react-query": "^5.108.4",
			"varlock": "1.25.0",
			"tailwindcss": "^4.3.5",
			"convex": "^1.51.0",
			"better-auth": "1.7.28",
			"@convex-dev/better-auth": "^0.13.1",
			"@tanstack/react-form": "^1.33.5",
			"@better-auth/expo": "1.7.28",
			"react": "19.3.1",
			"react-dom": "19.3.1",
			"@types/react": "^19.3.2",
			"@types/react-dom": "^19.3.0",
			"typescript": "^7.0.2"
		}
	},
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"check": "oxlint --fix && oxfmt --write",
		"check-types": "turbo run check-types",
		"deploy:prev": "bunx vercel deploy",
		"deploy:prod": "bunx vercel deploy --prod",
		"dev": "turbo run dev",
		"dev:native": "turbo run dev -F native --",
		"dev:server": "turbo run dev -F @zyvorn/backend --",
		"dev:vercel": "bunx vercel dev -L",
		"dev:web": "turbo run dev -F web --",
		"env:audit": "varlock audit -i .output -i dist -p ./apps/web && varlock audit -p ./apps/native",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/native/",
		"env:prev": "bun scripts/sync-vercel-env.ts preview",
		"env:prod": "bun scripts/sync-vercel-env.ts production",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/native/"
	},
	"devDependencies": {
		"@convex-dev/eslint-plugin": "^6.0.0",
		"@oxlint/plugins": "1.93.0",
		"@shadcn/lint": "^0.2.5",
		"@tailwindcss/language-server": "^0.16.0",
		"@tanstack/eslint-plugin-query": "^5.108.4",
		"@types/node": "catalog:",
		"@zyvorn/config": "workspace:*",
		"lefthook": "^2.2.3",
		"oxfmt": "^0.80.0",
		"oxlint": "1.93.0",
		"tailwint": "^1.1.16",
		"turbo": "^2.11.13",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"packageManager": "bun@1.4.2"
}
