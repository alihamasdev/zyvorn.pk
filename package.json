{
	"name": "zyvorn",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"zod": "^4.6.7",
			"@types/node": "^26.6.6",
			"@types/bun": "^1.4.4",
			"varlock": "1.24.0",
			"sonner": "^2.0.8",
			"tailwindcss": "^4.3.4",
			"convex": "^1.49.0",
			"better-auth": "1.7.18",
			"@convex-dev/better-auth": "^0.13.0",
			"@tanstack/react-form": "^1.33.5",
			"@better-auth/expo": "1.7.18",
			"react": "19.3.1",
			"react-dom": "19.3.1",
			"@types/react": "^19.3.0",
			"@types/react-dom": "^19.3.0",
			"typescript": "^7.0.2"
		}
	},
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"check": "oxlint --fix && oxfmt --write",
		"check-types": "turbo run check-types",
		"deploy:prev": "bunx vercel deploy",
		"deploy:prod": "bunx vercel deploy --prod",
		"dev": "turbo run dev",
		"dev:native": "turbo run dev -F native --",
		"dev:server": "turbo run dev -F @zyvorn/backend --",
		"dev:vercel": "bunx vercel dev -L",
		"dev:web": "turbo run dev -F web --",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/native/",
		"env:prev": "tsx scripts/sync-vercel-env.ts preview",
		"env:prod": "tsx scripts/sync-vercel-env.ts production",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/native/"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@convex-dev/eslint-plugin": "^5.0.1",
		"@shadcn/lint": "^0.2.5",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"@zyvorn/config": "workspace:*",
		"lefthook": "^2.2.1",
		"oxfmt": "^0.77.0",
		"oxlint": "^1.92.0",
		"tsx": "^4.23.13",
		"turbo": "^2.11.7",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"packageManager": "bun@1.4.2"
}
