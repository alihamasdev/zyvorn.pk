{
	"plugins": ["@ianvs/prettier-plugin-sort-imports", "prettier-plugin-tailwindcss"],
	"tabWidth": 2,
	"useTabs": true,
	"printWidth": 140,
	"singleQuote": false,
	"trailingComma": "all",
	"jsxSingleQuote": false,
	"importOrder": [
		"^(react/(.*)$)|^(react$)",
		"^(next/(.*)$)|^(next$)",
		"<THIRD_PARTY_MODULES>",
		"",
		"^@/lib/(.*)$",
		"^@/types/(.*)$",
		"^@/utils/(.*)$",
		"^@/hooks/(.*)$",
		"^@/store/(.*)$",
		"^@/context/(.*)$",
		"^@/components/ui/(.*)$",
		"^@/components/(.*)$",
		"^@/app/(.*)$",
		"^~/public/(.*)$",
		"",
		"^[./]"
	]
}
