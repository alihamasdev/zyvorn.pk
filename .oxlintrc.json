{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"ignorePatterns": ["node_modules/**", ".turbo/**", ".agents/**", "packages/backend/convex/**/_generated/**", "routeTree.gen.ts"],
	"plugins": ["react", "node", "typescript", "import", "unicorn", "oxc"],
	"jsPlugins": ["@shadcn/lint", "@convex-dev/eslint-plugin"],
	"categories": {
		"correctness": "warn"
	},
	"rules": {
		"shadcn/no-restyle": ["error", { "allow": ["layout"] }],
		"typescript/consistent-type-imports": ["warn", { "prefer": "type-imports", "fixStyle": "inline-type-imports" }]
	},
	"env": {
		"builtin": true
	},
	"overrides": [
		{
			"files": ["**/convex/**/*.ts"],
			"rules": {
				"@convex-dev/import-wrong-runtime": "off",
				"@convex-dev/no-old-registered-function-syntax": "error",
				"@convex-dev/require-args-validator": "error",
				"@convex-dev/require-access-control": "off",
				"@convex-dev/explicit-table-ids": "error",
				"@convex-dev/no-filter-in-query": "warn",
				"@convex-dev/no-top-of-hour-crons": "warn",
				"@convex-dev/no-schema-import-cycle": "error",
				"@convex-dev/no-duplicate-indexes": "error",
				"@convex-dev/no-process-env": "error"
			}
		}
	],
	"settings": {
		"react": {
			"version": "19.3.1"
		},
		"tailwindcss": {
			"callees": ["cva", "cn"]
		}
	}
}
